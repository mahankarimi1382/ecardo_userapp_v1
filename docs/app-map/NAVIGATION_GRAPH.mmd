    Login --> OTP[OTP Verification Screen]
    OTP --> PIN[PIN / Biometric Screen]
    AuthGate -- Yes --> NavShell[NavigationShell / Main Container]
    PIN --> NavShell

    subgraph ShellTabs [Main Shell Tabs & Primary Surfaces]
        NavShell --> TabHome[Home Screen / 8-Tile Grid]
        NavShell --> TabWallets[Wallets Screen]
        NavShell --> TabCards[Cards Screen]
        NavShell --> TabTransfers[Transfers Screen]
        NavShell --> TabTravel[Travel & eTrip Hub]
        NavShell --> TabHistory[Transaction History]
        NavShell --> TabSettings[Settings & Profile]
    end

    subgraph HomeActions [Dashboard Quick Actions]
        TabHome --> Services[All Services Catalog]
        TabHome --> QRPay[Scan & Pay QR]
        TabHome --> LiveRates[Live Exchange Rates]
        TabHome --> NotifCenter[Notification Center]
    end

    subgraph WalletFlows [Wallets & Accounts]
        TabWallets --> WalletDetail[Wallet Details & Ledger]
        TabWallets --> CreateWallet[Create New Currency Wallet]
        TabWallets --> TopUp[Deposit / Top-up]
        TabWallets --> Withdraw[Withdraw Funds]
    end

    subgraph CardFlows [Cards Module]
        TabCards --> CardDetail[Card Details & Security Actions]
