<?xml version="1.0" encoding="utf-8"?>
<!--
  eCardo User App — Network Security Config
  v1.0.4+5 — security audit fix

  - Disables cleartext traffic for all domains (HTTPS only).
  - Pins the system trust store for general traffic.
  - Allows debug-only cleartext for localhost (emulator dev only).
-->
<network-security-config>
    <!-- Default: HTTPS only, system trust store -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <!-- Remove <certificates src="user" /> to prevent
                 user-installed root CAs from intercepting traffic. -->
        </trust-anchors>
    </base-config>

    <!-- Debug-only: allow cleartext for local development (10.0.2.2 = emulator host) -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </domain-config>

    <!--
      ecardo.ir — production domain.
      Trust only system CAs (no user-installed CAs).
      This prevents MITM via installed root certificates.
    -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">ecardo.ir</domain>
        <domain includeSubdomains="true">trip.ecardo.ir</domain>
        <domain includeSubdomains="true">travel-origin.ecardo.ir</domain>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>
</network-security-config>
